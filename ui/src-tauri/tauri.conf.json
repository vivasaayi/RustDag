{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Tauri App",
    "version": "0.1.0",
    "identifier": "com.example.langgraphbuilder",
    "build": {
        "frontendDist": "../dist",
        "beforeDevCommand": "npm run start",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Tauri",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "app",
        "icon": []
    }
}